/target
**/*.rs.bk
*.pdb
.cargohome/
# Runtime data that must never be committed
/.local/
/tmp/
*.log

# proptest writes seeds for failing cases here. Confirmed counterexamples are
# kept as passing regression tests instead of committing generated
# seed files.
*.proptest-regressions

# Left behind by a cargo invocation that ran without CARGO_HOME set, which
# puts the registry cache in the working directory. Never part of the project.
/.global-cache
/.package-cache
/.package-cache-mutate
/registry/
